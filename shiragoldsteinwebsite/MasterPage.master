<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        html, body {
            min-height: 100vh; /* שומר שהפוטר יישאר למטה */
            margin: 0;
        }

        img.mi {
            margin-left: 20px;
            color: teal;
            width: 30px;
            height: 30px;
        }

        h1, h2, a {
            color: black;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: darkorange;
        }

        /* עיצוב לאזור העליון (כותרת ותפריט) */
        header {
            text-align: center;
            padding-top: 20px;
            padding-bottom: 10px;
        }

            /* ממורכז את טבלת התפריט */
            header table {
                margin: 0 auto;
            }

        main {
            flex: 1;
            width: 100%;
            background-color: darkorange; /* הוספנו את הצבע הכתום גם כאן */
        }

        /* אם את רוצה שהטקסט בגלריה יישאר קריא, נוודא שהכול שחור */
        main, header, footer {
            color: black;
        }

        input, textarea, select, button {
            border-radius: 10px; /* זה מה שעושה את הפינות המעוגלות */
            border: 1px solid #008080; /* הטורקיז מסביב */
            padding: 10px;
        }

        form {
            display: flex;
            flex-direction: column;
            gap: 1px;
            width: 350px;
            margin: 20px auto; /* ממקם את הטופס במרכז */
            padding: 30px;
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }
        /* עיצוב גלובלי לשדות הקלט */
        input, select {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            width: 100%;
        }

        /* כפתור שלח מעוצב */
        button {
            background-color: darkorange;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body dir="rtl">

    <header>

        <div style="margin-bottom: 10px;">
            שלום,
                <asp:Label ID="lblUserName" runat="server" Text="אורח"></asp:Label>
        </div>

        <table>
            <tr>
                <td>
                    <a href="דף בית.aspx">דף הבית
                        <img class="mi" src="images/House-Chimney-1--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a href="אודות.aspx">אודות
                        <img class="mi" src="images/Information-Circle--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a href="חיפוש.aspx">חיפוש
                        <img class="mi" src="images/Search--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="regLink" runat="server" href="הרשמה.aspx">הרשמה
                        <img class="mi" src="images/Pen-Write-Paper--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="logInlink" runat="server" href="כניסה.aspx">כניסה
                        <img class="mi" src="images/Login-Key--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="exitLink" runat="server" href="יציאה.aspx">יציאה
                        <img class="mi" src="images/Logout--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a href="תפריט.aspx">תפריט
                        <img class="mi" src="images/Taking-Pictures-Cameras--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="adminLink" runat="server" href="מנהל.aspx">מנהל
                        <img class="mi" src="images/Youtube-Studio-Logo--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a href="עדכון פרטים.aspx">עדכון פרטים
                        <img class="mi" src="images/Single-Neutral-Actions-Sync--Streamline-Ultimate.png" />
                    </a>
                </td>
            </tr>
        </table>
    </header>

    <main>
        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>
    </main>

    <footer>
        איזה כיף שבאתם לבקר
    </footer>
</body>
</html>
