<%@ Master Language="C#" AutoEventWireup="true" CodeFile="MasterPage.master.cs" Inherits="MasterPage" %>

<!DOCTYPE html>

<html>
<head runat="server">
    <asp:ContentPlaceHolder ID="head" runat="server">
    </asp:ContentPlaceHolder>
    <style>
        .card {
            background-color: white; /* הרקע הלבן שחסר לך */
            border-radius: 10px;
            padding: 15px;
            margin: 10px;
            width: 300px; /* רוחב המנה */
            box-shadow: 0 4px 8px rgba(0,0,0,0.2); /* הצל שנותן את המראה המקצועי */
            text-align: right;
            display: inline-block; /* מוודא שהם יושבים אחד ליד השני */
            vertical-align: top;
            border: 1px solid black;
        }

        /* זה העיצוב של אזור הגלריה הכללי */
        .gallery {
            display: flex;
            flex-wrap: wrap;
            justify-content: center; /* כדי שזה יהיה ממורכז יפה */
            direction: rtl;
            padding: 20px;
        }

        html, body {
            min-height: 100vh; /* שומר שהפוטר יישאר למטה */
            margin: 0;
        }

        img.mi {
            margin-left: 20px;
            color: teal;
            width: 30px;
            height: 30px;
        }

        h1, h2, a {
            color: black;
        }

        body {
            display: flex;
            flex-direction: column;
            background-color: darkorange;
        }

        /* עיצוב לאזור העליון (כותרת ותפריט) */
        header {
            text-align: center;
            padding-top: 20px;
            padding-bottom: 10px;
            position: relative; /* מאפשר לילדים בתוכו להיות ממוקמים ביחס אליו */
        }

        .cart-link-container {
            position: absolute;
            top: 10px;
            left: 20px; /* זה מה שמצמיד אותו לצד שמאל */
        }

        .cart-link {
            display: flex;
            align-items: center;
            text-decoration: none;
            font-weight: bold;
            color: black;
        }

        /* ממורכז את טבלת התפריט */
        header table {
            margin: 0 auto;
        }

        main {
            flex: 1;
            width: 100%;
            background-color: darkorange; /* הוספנו את הצבע הכתום גם כאן */
        }

        /* אם את רוצה שהטקסט בגלריה יישאר קריא, נוודא שהכול שחור */
        main, header, footer {
            color: black;
        }

        input, textarea, select, button {
            border-radius: 10px; /* זה מה שעושה את הפינות המעוגלות */
            border: 1px solid #008080; /* הטורקיז מסביב */
            padding: 10px;
        }

        /*form {
            display: flex;
            flex-direction: column;
            gap: 1px;
            width: 350px;
            margin: 20px auto;*/ /* ממקם את הטופס במרכז*/
        /*padding: 30px;
            background-color: #ffffff;
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0,0,0,0.2);
        }*/

        .form-narrow {
            width: 350px;
            margin: 20px auto;
            background-color: white;
            padding: 30px;
            border: 1px solid black;
        }

        /* עיצוב גלובלי לשדות הקלט */
        input, select {
            padding: 10px;
            border: 1px solid #ccc;
            border-radius: 8px;
            font-size: 16px;
            width: 100%;
        }

        /* כפתור שלח מעוצב */
        button {
            background-color: darkorange;
            color: white;
            padding: 12px;
            border: none;
            border-radius: 8px;
            font-weight: bold;
            cursor: pointer;
        }
    </style>
</head>
<body dir="rtl">

    <header>

        <div class="cart-link-container">
            <a href="הסל_שלי.aspx" class="cart-link">  הסל שלי    
           <asp:Label ID="lblCartCount" runat="server" Text="(0)" style="margin-right: 5px; color: black; font-weight: bold;"></asp:Label>
                <img class="mi" src="images/Shopping-Cart-3--Streamline-Nova%20(2).png"   />
            </a>
        </div>

        <div style="margin-bottom: 10px;">
            שלום,
                <asp:Label ID="lblUserName" runat="server" Text="אורח"></asp:Label>
        </div>

        <table>
            <tr>
                <td>
                    <a href="דף בית.aspx">דף הבית
                        <img class="mi" src="images/House-Chimney-1--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a href="אודות.aspx">אודות
                        <img class="mi" src="images/Information-Circle--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a href="חיפוש.aspx">חיפוש
                        <img class="mi" src="images/Search--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="regLink" runat="server" href="הרשמה.aspx">הרשמה
                        <img class="mi" src="images/Pen-Write-Paper--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="logInlink" runat="server" href="כניסה.aspx">כניסה
                        <img class="mi" src="images/Login-Key--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="exitLink" runat="server" href="יציאה.aspx">יציאה
                        <img class="mi" src="images/Logout--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a href="תפריט.aspx">תפריט
                        <img class="mi" src="images/Taking-Pictures-Cameras--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="adminLink" runat="server" href="מנהל.aspx">מנהל
                        <img class="mi" src="images/Youtube-Studio-Logo--Streamline-Ultimate.png" />
                    </a>
                </td>
                <td>
                    <a id="updateLink" runat="server" href="עדכון פרטים.aspx">עדכון פרטים
                        <img class="mi" src="images/Single-Neutral-Actions-Sync--Streamline-Ultimate.png" />
                    </a>
                </td>
            </tr>

        </table>
    </header>

    <main>

        <asp:ContentPlaceHolder ID="ContentPlaceHolder1" runat="server">
        </asp:ContentPlaceHolder>


    </main>

    <footer>
        איזה כיף שבאתם לבקר
    </footer>
</body>
</html>
